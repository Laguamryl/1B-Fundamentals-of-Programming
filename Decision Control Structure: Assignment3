        if (salary <= 3500 && (nsat + exam) / 2.0 >= 91) {
            return "ACCEPTED";
        }
        return "FOR FURTHER STUDY";
    }
}

JOptionPane
import javax.swing.*;

public class scholarJOptionPane {
    public static void main(String[] args){
        String nsatInput = JOptionPane.showInputDialog(null, "Enter NSAT score:");
        double nsat = Double.parseDouble(nsatInput.trim());

