BufferedReader
import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

public class bufferedReaderGrossPay {
    public static void main (String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        System.out.print("Enter hourly pay rate (Php): ");
        double rate = Double.parseDouble(br.readLine().trim());

        System.out.print("Enter hours worked: ");
        double hours = Double.parseDouble(br.readLine().trim());

        double gross = rate * hours;
        double ratePay = getWithHoldingRate(gross);
        double tax = gross * ratePay / 100;
        double net = gross - tax;

        System.out.printf("Gross Pay:      Php %.2f%n", gross);
        System.out.printf("Withholding:    %.0f%% = Php %.2f%n", ratePay, tax);
        System.out.printf("Net Pay:        Php %.2f%n", net);
    }
    static double getWithHoldingRate(double gross) {
        if (gross <= 2000.00) return 10;
        else if (gross <= 4000.00) return 12;
        else if (gross <= 10000.00) return 15;
        else return 20;
    }
}

Scanner
import java.util.Scanner;

public class grossPayScanner {
